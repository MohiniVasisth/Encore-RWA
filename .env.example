# ─────────────────────────────────────────────────────────────────────────────
# Encore — environment configuration
# Copy to `.env` and fill in. NOTHING here is committed. Testnet only.
# Every value marked  ⟵ YOU PROVIDE  must come from you (see docs/HEDERA_RESOURCES_NEEDED.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ── Operator / deployer (pays for everything) ────────────────────────────────
# Hedera account id + its ECDSA keys. Create at https://portal.hedera.com
OPERATOR_ID=0.0.xxxxxx                     # ⟵ YOU PROVIDE
OPERATOR_KEY=302e0201...                   # ⟵ YOU PROVIDE  (DER private key, ED25519 or ECDSA)
EVM_OPERATOR_KEY=0x...                     # ⟵ YOU PROVIDE  (raw ECDSA hex key for Hardhat / ethers)

# ── Pre-created role accounts (backend signs for these) ──────────────────────
# Each: Hedera account id + ECDSA private key (hex, 0x-prefixed) + EVM address.
ORGANIZER_ID=0.0.xxxxxx                    # ⟵ YOU PROVIDE
ORGANIZER_KEY=0x...                        # ⟵ YOU PROVIDE
ORGANIZER_EVM=0x...                        # ⟵ YOU PROVIDE

INVESTOR1_ID=0.0.xxxxxx                    # ⟵ YOU PROVIDE
INVESTOR1_KEY=0x...                        # ⟵ YOU PROVIDE
INVESTOR1_EVM=0x...                        # ⟵ YOU PROVIDE

INVESTOR2_ID=0.0.xxxxxx                    # ⟵ YOU PROVIDE
INVESTOR2_KEY=0x...                        # ⟵ YOU PROVIDE
INVESTOR2_EVM=0x...                        # ⟵ YOU PROVIDE

ADMIN_ID=0.0.xxxxxx                        # ⟵ YOU PROVIDE
ADMIN_KEY=0x...                            # ⟵ YOU PROVIDE
ADMIN_EVM=0x...                            # ⟵ YOU PROVIDE

# A "fan" account for buying/reselling tickets (can reuse INVESTOR2 to save setup).
FAN_ID=0.0.xxxxxx                          # ⟵ YOU PROVIDE
FAN_KEY=0x...                              # ⟵ YOU PROVIDE
FAN_EVM=0x...                              # ⟵ YOU PROVIDE

# ── Tokens ───────────────────────────────────────────────────────────────────
# Stablecoin: run `npm run hedera:stablecoin` to create one, then paste the ids.
STABLECOIN_TOKEN_ID=0.0.xxxxxx             # filled by createStablecoin.js
STABLECOIN_EVM_ADDRESS=0x...               # ERC-20 facade; filled by createStablecoin.js
STABLECOIN_DECIMALS=6

# Ticket NFT: run `npm run hedera:ticket-nft` after the escrow is deployed.
TICKET_NFT_TOKEN_ID=0.0.xxxxxx             # filled by createTicketNft.js
TICKET_RESALE_ROYALTY_BPS=1000             # 10%

# ATS revenue-right token: issue via the ATS UI, then paste here.
REVENUE_RIGHT_TOKEN_ID=0.0.xxxxxx          # ⟵ YOU PROVIDE (from ATS)
REVENUE_RIGHT_EVM_ADDRESS=0x...            # ⟵ YOU PROVIDE (from ATS)
REVENUE_RIGHT_TOTAL_SUPPLY=3000

# ── ATS mode ─────────────────────────────────────────────────────────────────
# mock → use contracts/mocks/MockRevenueRightToken.sol, no ATS deployment needed.
# ats  → use a real ATS security-token diamond (fill REVENUE_RIGHT_EVM_ADDRESS
#        above with the diamond proxy address; the backend calls facet functions
#        on it directly via ethers, signed by ADMIN).
ATS_MODE=mock
MOCK_REVENUE_RIGHT_ADDRESS=0x...           # filled by deployMockRevenueRight.js (mock mode)

# ATS deployment (ats mode). ATS has no canonical public testnet deployment —
# deploy it yourself from github.com/hashgraph/asset-tokenization-studio
# (packages/ats/contracts → `npm run deploy:hardhat -- --network hedera-testnet`)
# or paste a Factory/Resolver you already have. Used only by ATS deploy tooling.
ATS_FACTORY_ADDRESS=0.0.xxxxxx             # ⟵ YOU PROVIDE (ats mode)
ATS_RESOLVER_ADDRESS=0.0.xxxxxx            # ⟵ YOU PROVIDE (ats mode)
# Raw ECDSA key of the ATS token's DEFAULT_ADMIN (diamond owner). Only used by
# scripts/ats/grantRoles.js to grant the Encore admin its ATS roles.
ATS_OWNER_KEY=0x...                        # ⟵ YOU PROVIDE (ats mode; defaults to EVM_OPERATOR_KEY)
ATS_KYC_VALIDITY_YEARS=5

# dividend → register an ATS equity dividend (corporate action) at settlement.
# escrow   → settle via TicketEscrow.allocatePayouts from a mirror-node snapshot.
ATS_SETTLEMENT_PATH=escrow

# ── Deployed Encore contracts (filled by deploy scripts) ─────────────────
FUNDING_VAULT_ADDRESS=0x...
TICKET_ESCROW_ADDRESS=0x...

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
# Where royalty fees land. Set this to the TicketEscrow address once deployed so
# resale royalties flow straight into the investor pool.
ROYALTY_COLLECTOR_ID=0.0.xxxxxx            # = TICKET_ESCROW as a 0.0.x id (createTicketNft.js resolves it)
